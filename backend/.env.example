APP_NAME=zeno
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_TIMEZONE=UTC

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zeno
DB_USERNAME=zeno
DB_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=zeno
REVERB_APP_KEY=local
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# The app runs inside Docker and publishes to Reverb by its compose service
# name, not through the host-mapped port the browser uses.
REVERB_PUBLISH_HOST=reverb
REVERB_PUBLISH_PORT=8080

# Exposed to the browser so Laravel Echo can reach Reverb from the client. If
# docker-compose remaps Reverb to a different host port (REVERB_PORT in the
# repo-root .env), set VITE_REVERB_PORT to that host-side port.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── تكاملات ───────────────────────────────────────
# القيم الافتراضية آمنة للإنتاج. البدائل المؤقتة (log/fixed) تمنع الإقلاع
# في الإنتاج عمداً — راجع docs/26-external-integrations-and-stubs.md
SMS_DRIVER=log
OTP_GENERATOR=random
OTP_FIXED_CODE=
